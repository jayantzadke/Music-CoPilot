{
  "name": "music-pilot-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:proxy": "tsx watch src/server.dev.ts",
    "build": "tsc --project tsconfig.json",
