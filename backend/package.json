    "@fastify/swagger": "8.14.0",
    "bcryptjs": "2.4.3",
    "dotenv": "16.4.5",
    "drizzle-orm": "0.31.4",
    "fastify": "4.28.1",
    "fastify-plugin": "^5.1.0",
    "ioredis": "5.3.2",
    "pino": "9.3.2",
    "postgres": "3.4.4",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.14.11",
    "drizzle-kit": "0.22.8",
    "pino-pretty": "^13.1.3",
    "tsx": "4.16.2",
